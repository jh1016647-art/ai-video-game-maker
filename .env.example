const promptInput = document.getElementById('promptInput');
const styleSelect = document.getElementById('styleSelect');
const genreSelect = document.getElementById('genreSelect');
const modelSelect = document.getElementById('modelSelect');
const projectNameInput = document.getElementById('projectName');
const generateBtn = document.getElementById('generateBtn');
const videoBtn = document.getElementById('videoBtn');
const gameBtn = document.getElementById('gameBtn');
const playBtn = document.getElementById('playBtn');
const exportBtn = document.getElementById('exportBtn');
const resetGameBtn = document.getElementById('resetGameBtn');
const statusText = document.getElementById('statusText');

const videoTitle = document.getElementById('videoTitle');
const videoConcept = document.getElementById('videoConcept');
const videoShots = document.getElementById('videoShots');
const videoDuration = document.getElementById('videoDuration');
const videoStyle = document.getElementById('videoStyle');

const gameTitle = document.getElementById('gameTitle');
const gameObjective = document.getElementById('gameObjective');
const gameMechanics = document.getElementById('gameMechanics');
const gameGenre = document.getElementById('gameGenre');
const gameLevel = document.getElementById('gameLevel');

const previewTitle = document.getElementById('previewTitle');
const projectSummary = document.getElementById('projectSummary');
const summaryMood = document.getElementById('summaryMood');
const summaryGoal = document.getElementById('summaryGoal');
const summaryVision = document.getElementById('summaryVision');
const summaryAi = document.getElementById('summaryAi');

const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

let gameState = null;
let animationFrame = null;

function setStatus(message) {
  statusText.textContent = message;
}

function renderProjectSummary(data) {
  const style = data.style || styleSelect.value;
  const genre = data.genre || genreSelect.value;
  const projectName = projectNameInput.value.trim() || 'Untitled Project';
  previewTitle.textContent = projectName;

  projectSummary.textContent = `This concept packages a ${style} video treatment and a ${genre} game prototype for “${promptInput.value.trim() || 'a cinematic adventure'}.” The combination creates a strong narrative hook, modular level design, and visual identity that can expand into a larger creative pipeline.`;
  summaryMood.textContent = style.charAt(0).toUpperCase() + style.slice(1);
  summaryGoal.textContent = `${data.game?.objective || 'Create a playable, marketable concept.'}`;
  summaryVision.textContent = `${data.video?.palette || 'High-contrast cinematic world'} visual language`;
  summaryAi.textContent = modelSelect.value === 'offline' ? 'Offline mock mode' : `${modelSelect.value} ready`;
}

function renderVideoCard(video) {
  if (!video) return;

  videoTitle.textContent = video.title || 'Untitled Story';
  videoConcept.textContent = video.concept || 'A bold visual concept ready for production.';
  videoDuration.textContent = `Duration: ${video.duration || '45 seconds'}`;
  videoStyle.textContent = `Style: ${video.style || styleSelect.value}`;

  if (Array.isArray(video.shots)) {
    videoShots.innerHTML = video.shots.map((shot) => `<li>${shot}</li>`).join('');
  } else {
    videoShots.innerHTML = '<li>Wide cinematic establishing shot</li><li>Hero action sequence</li><li>Final visual payoff</li>';
  }
}

function renderGameCard(game) {
  if (!game) return;

  gameTitle.textContent = game.title || 'Untitled Quest';
  gameObjective.textContent = game.objective || 'Reach the goal and survive the environment.';
  gameGenre.textContent = `Genre: ${game.genre || genreSelect.value}`;
  gameLevel.textContent = `Level concept: ${game.levelIdea || 'A multi-route arena with skill-based progression.'}`;

  if (Array.isArray(game.mechanics)) {
    gameMechanics.innerHTML = game.mechanics.map((item) => `<li>${item}</li>`).join('');
  } else {
    gameMechanics.innerHTML = '<li>Fast movement and responsive controls</li><li>Collect power-ups</li><li>Progress through layered challenge loops</li>';
  }
}

async function generateProject() {
  const prompt = promptInput.value.trim() || 'A neon dragon guarding a floating city at sunrise';
  const style = styleSelect.value;
  const genre = genreSelect.value;
  setStatus(`Generating concept for: ${prompt}`);

  try {
    const response = await fetch(`/api/generate?prompt=${encodeURIComponent(prompt)}&style=${encodeURIComponent(style)}&genre=${encodeURIComponent(genre)}`);
    const data = await response.json();

    renderVideoCard(data.video);
    renderGameCard(data.game);
    renderProjectSummary(data);
    setupGame(data.game.title, prompt);
    setStatus('Concept generated successfully.');
  } catch (error) {
    console.error(error);
    setStatus('Generation failed. Please try again.');
  }
}

async function generateVideoOnly() {
  const prompt = promptInput.value.trim() || 'A neon dragon guarding a floating city at sunrise';
  const style = styleSelect.value;
  setStatus('Generating storyboard...');

  try {
    const response = await fetch(`/api/video?prompt=${encodeURIComponent(prompt)}&style=${encodeURIComponent(style)}`);
    const data = await response.json();
    renderVideoCard(data.video);
    renderProjectSummary({ style, genre: genreSelect.value, video: data.video, game: { objective: 'Playable concept in development' } });
    setStatus('Video storyboard generated.');
  } catch (error) {
    console.error(error);
    setStatus('Video generation failed.');
  }
}

async function generateGameOnly() {
  const prompt = promptInput.value.trim() || 'A neon dragon guarding a floating city at sunrise';
  const genre = genreSelect.value;
  setStatus('Generating game concept...');

  try {
    const response = await fetch(`/api/game?prompt=${encodeURIComponent(prompt)}&genre=${encodeURIComponent(genre)}`);
    const data = await response.json();
    renderGameCard(data.game);
    renderProjectSummary({ style: styleSelect.value, genre, game: data.game, video: { palette: 'Cinematic palette' } });
    setStatus('Game design generated.');
  } catch (error) {
    console.error(error);
    setStatus('Game generation failed.');
  }
}

function downloadProject() {
  const prompt = promptInput.value.trim() || 'creative prompt';
  const url = `/api/export?prompt=${encodeURIComponent(prompt)}&style=${encodeURIComponent(styleSelect.value)}&genre=${encodeURIComponent(genreSelect.value)}`;
  window.open(url, '_blank');
  setStatus('Project JSON downloaded.');
}

function setupGame(name, prompt) {
  const player = {
    x: 90,
    y: 265,
    width: 26,
    height: 26,
    speed: 4,
    vx: 0,
    vy: 0,
    jumpPower: 11,
    color: '#22d3ee'
  };

  const goal = {
    x: 650,
    y: 180,
    width: 30,
    height: 30,
    color: '#f9a8d4'
  };

  const stars = Array.from({ length: 8 }, (_, index) => ({
    x: 150 + index * 70,
    y: 120 + (index % 2) * 70,
    r: 9,
    color: index % 2 === 0 ? '#facc15' : '#f97316'
  }));

  const obstacles = [
    { x: 310, y: 250, w: 120, h: 18, color: '#fb7185' },
    { x: 515, y: 220, w: 110, h: 18, color: '#f87171' }
  ];

  const keys = { left: false, right: false, jump: false };

  gameState = { prompt, name, player, goal, stars, obstacles, keys, score: 0, won: false };
  drawGame();
}

function drawGame() {
  if (!gameState) return;

  ctx.clearRect(0, 0, canvas.width, canvas.height);

  const { player, goal, stars, obstacles, score, won } = gameState;

  ctx.fillStyle = '#07131d';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = 'rgba(34, 211, 238, 0.18)';
  ctx.fillRect(0, 300, canvas.width, 80);

  ctx.fillStyle = '#e2e8f0';
  ctx.font = '600 16px Inter';
  ctx.fillText(`${gameState.name} — score: ${score}`, 18, 26);

  player.vx = 0;
  if (gameState.keys.left) player.vx = -player.speed;
  if (gameState.keys.right) player.vx = player.speed;
  player.x += player.vx;

  player.vy += 0.7;
  player.y += player.vy;

  if (player.y >= 300 - player.height) {
    player.y = 300 - player.height;
    player.vy = 0;
  }

  stars.forEach((star) => {
    const dx = player.x + player.width / 2 - star.x;
    const dy = player.y + player.height / 2 - star.y;
    const dist = Math.hypot(dx, dy);
    if (dist < 24) {
      star.x = -100;
      gameState.score += 10;
    }

    ctx.beginPath();
    ctx.fillStyle = star.color;
    ctx.arc(star.x, star.y, star.r, 0, Math.PI * 2);
    ctx.fill();
  });

  obstacles.forEach((obstacle) => {
    const hit =
      player.x < obstacle.x + obstacle.w &&
      player.x + player.width > obstacle.x &&
      player.y < obstacle.y + obstacle.h &&
      player.y + player.height > obstacle.y;

    if (hit) {
      if (player.x + player.width <= obstacle.x + 10) {
        player.x = obstacle.x - player.width;
      } else if (player.x >= obstacle.x + obstacle.w - 10) {
        player.x = obstacle.x + obstacle.w;
      } else {
        player.y = obstacle.y - player.height;
        player.vy = 0;
      }
    }

    ctx.fillStyle = obstacle.color;
    ctx.fillRect(obstacle.x, obstacle.y, obstacle.w, obstacle.h);
  });

  const reachedGoal =
    player.x < goal.x + goal.width &&
    player.x + player.width > goal.x &&
    player.y < goal.y + goal.height &&
    player.y + player.height > goal.y;

  if (reachedGoal) {
    gameState.won = true;
    ctx.fillStyle = '#f8fafc';
    ctx.font = '700 28px Inter';
    ctx.fillText('Level complete!', 260, 120);
  }

  ctx.fillStyle = goal.color;
  ctx.fillRect(goal.x, goal.y, goal.width, goal.height);

  ctx.fillStyle = player.color;
  ctx.fillRect(player.x, player.y, player.width, player.height);

  if (player.x < 0) player.x = 0;
  if (player.x + player.width > canvas.width) player.x = canvas.width - player.width;

  if (!won) {
    animationFrame = requestAnimationFrame(drawGame);
  }
}

function handleKeyDown(event) {
  const key = event.key.toLowerCase();
  if (event.key === 'ArrowLeft' || key === 'a') gameState.keys.left = true;
  if (event.key === 'ArrowRight' || key === 'd') gameState.keys.right = true;
  if (event.key === 'ArrowUp' || key === 'w' || event.key === ' ') {
    if (gameState && gameState.player.y >= 270) {
      gameState.player.vy = -gameState.player.jumpPower;
    }
  }
}

function handleKeyUp(event) {
  const key = event.key.toLowerCase();
  if (event.key === 'ArrowLeft' || key === 'a') gameState.keys.left = false;
  if (event.key === 'ArrowRight' || key === 'd') gameState.keys.right = false;
}

function playDemo() {
  if (!gameState) {
    generateProject();
    return;
  }
  if (animationFrame) cancelAnimationFrame(animationFrame);
  drawGame();
}

function resetGame() {
  if (!gameState) return;
  if (animationFrame) cancelAnimationFrame(animationFrame);
  setupGame(gameState.name, gameState.prompt);
}

generateBtn.addEventListener('click', generateProject);
videoBtn.addEventListener('click', generateVideoOnly);
gameBtn.addEventListener('click', generateGameOnly);
playBtn.addEventListener('click', playDemo);
exportBtn.addEventListener('click', downloadProject);
resetGameBtn.addEventListener('click', resetGame);

document.addEventListener('keydown', handleKeyDown);
document.addEventListener('keyup', handleKeyUp);

generateProject();
